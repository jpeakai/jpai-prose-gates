{
  "name": "@jpeakai/prose-gates",
  "version": "0.1.0",
  "type": "module",
  "description": "Deterministic prose gates for markdown documentation",
  "license": "MIT",
  "keywords": [
    "markdown",
    "prose",
    "lint",
    "documentation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpeakai/jpai-prose-gates.git"
  },
  "homepage": "https://github.com/jpeakai/jpai-prose-gates#readme",
  "bugs": "https://github.com/jpeakai/jpai-prose-gates/issues",
  "packageManager": "bun@1.3.12",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "make check",
    "prepack": "make build"
  },
  "bin": {
    "prose-gates": "dist/bin.js"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "unist-util-visit-parents": "^6.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/bun": "latest",
    "@types/mdast": "^4",
    "fast-check": "^4.10.0",
    "typescript": "^5"
  }
}
